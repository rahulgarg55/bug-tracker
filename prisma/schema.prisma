datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  avatar         String?
  role           String    @default("Software Engineer")
  createdAt      DateTime  @default(now())
  
  assignedIssues Issue[]   @relation("Assignee")
  reportedIssues Issue[]   @relation("Reporter")
  comments       Comment[]
}

model Project {
  id          String      @id @default(cuid())
  name        String
  key         String      @unique
  description String?
  category    String      @default("Web Application")
  status      String      @default("ACTIVE")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  issues      Issue[]
  milestones  Milestone[]
}

model Milestone {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("OPEN")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      Issue[]
}

model Issue {
  id              String     @id @default(cuid())
  key             String     @unique
  title           String
  description     String?
  type            String     @default("BUG")
  status          String     @default("OPEN")
  priority        String     @default("MEDIUM")
  severity        String     @default("MODERATE")
  module          String     @default("General")
  reproducibility String     @default("Always")
  environment     String     @default("Production")
  dueDate         DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId     String?
  milestone       Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  assigneeId      String?
  assignee        User?      @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId      String?
  reporter        User?      @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)

  comments        Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
