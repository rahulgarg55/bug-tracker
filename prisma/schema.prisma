datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 1. Identity & Authentication (Auth.js / NextAuth v5)
// -----------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  avatar         String?
  jobTitle       String?   @default("Software Engineer")
  status         String    @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Multi-Tenancy Relations
  memberships         Membership[]
  teamMemberships     TeamMember[]
  projectMembers      ProjectMember[]
  ownedProjects       Project[]             @relation("ProjectOwner")
  createdProjects     Project[]             @relation("ProjectCreator")
  sentInvitations     Invitation[]          @relation("InvitedBy")
  passwordResetTokens PasswordResetToken[]

  // Issue & Activity Relations
  assignedIssues      Issue[]               @relation("Assignee")
  reportedIssues      Issue[]               @relation("Reporter")
  comments            Comment[]
  uploadedAttachments Attachment[]
  issueActivities     IssueActivity[]

  // Auth.js Core Relations
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// 2. Multi-Tenancy: Organizations, Memberships & Invitations
// -----------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED, SUSPENDED
  plan        String   @default("FREE") // FREE, PRO, ENTERPRISE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  Membership[]
  teams        Team[]
  projects     Project[]
  issues       Issue[]
  labels       Label[]
  invitations  Invitation[]
  auditLogs    AuditLog[]

  @@index([slug])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER, ADMIN, PROJECT_ADMIN, PROJECT_MANAGER, DEVELOPER, QA_ENGINEER, PRODUCT_MANAGER, REPORTER, VIEWER, GUEST
  status         String       @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("MEMBER") // OWNER, ADMIN, MEMBER, GUEST
  token          String       @unique
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation("InvitedBy", fields: [inviterId], references: [id], onDelete: Cascade)
  status         String       @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED

  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([token])
}

// -----------------------------------------------------------------------------
// 3. Teams & Squads
// -----------------------------------------------------------------------------

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members        TeamMember[]
  projects       Project[]
  issues         Issue[]

  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // LEAD, MEMBER

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// 4. Projects & Project Memberships (Phase 2)
// -----------------------------------------------------------------------------

model Project {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  key            String          // Unique project identifier (e.g. ACME, PAY, WEB)
  description    String?
  category       String          @default("Software Development")
  projectType    String          @default("SOFTWARE") // SOFTWARE, SERVICE_DESK, BUSINESS
  status         String          @default("ACTIVE") // ACTIVE, ARCHIVED, COMPLETED

  ownerId        String?
  owner          User?           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  teamId         String?
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)

  startDate      DateTime?
  targetDate     DateTime?

  createdById    String?
  createdBy      User?           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  issueCounter   Int             @default(0)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  issues         Issue[]
  milestones     Milestone[]
  members        ProjectMember[]
  labels         Label[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([teamId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("DEVELOPER") // PROJECT_ADMIN, PROJECT_MANAGER, DEVELOPER, QA_ENGINEER, REPORTER, VIEWER

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Milestone {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("OPEN")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      Issue[]

  @@index([projectId])
}

// -----------------------------------------------------------------------------
// 5. Issues, Bugs, Comments & Relationships (Phase 2)
// -----------------------------------------------------------------------------

model Issue {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  key             String       // e.g. ACME-12
  number          Int          @default(1)
  title           String
  description     String?

  type            String       @default("TASK") // EPIC, STORY, TASK, BUG, SUBTASK, FEATURE, IMPROVEMENT, SUPPORT_TICKET, CHANGE_REQUEST
  status          String       @default("TODO") // BACKLOG, TODO, IN_PROGRESS, CODE_REVIEW, QA, DONE, REOPENED, DUPLICATE, REJECTED, WONT_FIX, CANNOT_REPRODUCE, CLOSED
  priority        String       @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW, LOWEST
  severity        String?      // BLOCKER, CRITICAL, MAJOR, MINOR, TRIVIAL (specifically for BUGs)

  // Environment & Bug Fields
  environment     String?      @default("Production")
  module          String?      @default("General")
  reproducibility String?      @default("Always")
  operatingSystem String?
  browser         String?
  device          String?
  appVersion      String?
  stepsToReproduce String?
  expectedResult  String?
  actualResult    String?
  logs            String?
  stackTrace      String?
  component       String?

  // Estimates & Time
  estimate        Float?       // Hours or points
  timeSpent       Float?       // Hours
  dueDate         DateTime?

  // Issue Hierarchy
  parentIssueId   String?
  parentIssue     Issue?       @relation("IssueHierarchy", fields: [parentIssueId], references: [id], onDelete: SetNull)
  subIssues       Issue[]      @relation("IssueHierarchy")

  milestoneId     String?
  milestone       Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  assigneeId      String?
  assignee        User?        @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId      String?
  reporter        User?        @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  comments        Comment[]
  labels          IssueLabel[]
  attachments     Attachment[]
  activities      IssueActivity[]
  sourceRelations IssueRelationship[] @relation("SourceIssue")
  targetRelations IssueRelationship[] @relation("TargetIssue")

  @@unique([organizationId, key])
  @@index([organizationId, projectId])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([parentIssueId])
  @@index([teamId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Label {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name           String
  color          String       @default("#3b82f6") // Hex color
  description    String?
  createdAt      DateTime     @default(now())

  issues         IssueLabel[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([projectId])
}

model IssueLabel {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  labelId   String
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([issueId, labelId])
  @@index([issueId])
  @@index([labelId])
}

model IssueRelationship {
  id            String   @id @default(cuid())
  sourceIssueId String
  sourceIssue   Issue    @relation("SourceIssue", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  targetIssueId String
  targetIssue   Issue    @relation("TargetIssue", fields: [targetIssueId], references: [id], onDelete: Cascade)
  type          String   // PARENT_CHILD, BLOCKS, BLOCKED_BY, RELATES_TO, DUPLICATE, DUPLICATED_BY
  createdAt     DateTime @default(now())

  @@unique([sourceIssueId, targetIssueId, type])
  @@index([sourceIssueId])
  @@index([targetIssueId])
}

model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // CREATED, UPDATED, STATUS_CHANGED, PRIORITY_CHANGED, ASSIGNEE_CHANGED, COMMENT_ADDED, ATTACHMENT_ADDED, RELATIONSHIP_ADDED
  field     String?
  oldValue  String?
  newValue  String?
  metadata  String?  // JSON formatted details
  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fileName   String
  fileSize   Int
  mimeType   String
  url        String
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([issueId])
}

// -----------------------------------------------------------------------------
// 6. Security & Audit Trail
// -----------------------------------------------------------------------------

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  action         String       // e.g. "USER_INVITED", "ROLE_UPDATED", "PROJECT_CREATED"
  resourceType   String       // e.g. "ORGANIZATION", "TEAM", "PROJECT", "ISSUE"
  resourceId     String?
  details        String?      // JSON metadata string
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}
