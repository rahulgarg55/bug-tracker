datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 1. Identity & Authentication (Auth.js / NextAuth v5)
// -----------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  avatar         String?
  jobTitle       String?   @default("Software Engineer")
  status         String    @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Multi-Tenancy Relations
  memberships         Membership[]
  teamMemberships     TeamMember[]
  projectMembers      ProjectMember[]
  sentInvitations     Invitation[]          @relation("InvitedBy")
  passwordResetTokens PasswordResetToken[]

  // Issue & Activity Relations
  assignedIssues Issue[]   @relation("Assignee")
  reportedIssues Issue[]   @relation("Reporter")
  comments       Comment[]

  // Auth.js Core Relations
  accounts       Account[]
  sessions       Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// 2. Multi-Tenancy: Organizations, Memberships & Invitations
// -----------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED, SUSPENDED
  plan        String   @default("FREE") // FREE, PRO, ENTERPRISE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  Membership[]
  teams        Team[]
  projects     Project[]
  issues       Issue[]
  invitations  Invitation[]
  auditLogs    AuditLog[]

  @@index([slug])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER, ADMIN, PROJECT_ADMIN, PROJECT_MANAGER, DEVELOPER, QA_ENGINEER, PRODUCT_MANAGER, REPORTER, VIEWER, GUEST
  status         String       @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("MEMBER") // OWNER, ADMIN, MEMBER, GUEST
  token          String       @unique
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation("InvitedBy", fields: [inviterId], references: [id], onDelete: Cascade)
  status         String       @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED

  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([token])
}

// -----------------------------------------------------------------------------
// 3. Teams & Project Workspaces
// -----------------------------------------------------------------------------

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members        TeamMember[]

  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // LEAD, MEMBER

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  key            String
  description    String?
  category       String          @default("Web Application")
  status         String          @default("ACTIVE") // ACTIVE, ARCHIVED

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  issues         Issue[]
  milestones     Milestone[]
  members        ProjectMember[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([organizationId, status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("CONTRIBUTOR") // MANAGER, CONTRIBUTOR, VIEWER

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("OPEN")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      Issue[]

  @@index([projectId])
}

// -----------------------------------------------------------------------------
// 4. Issues, Defects & Comments
// -----------------------------------------------------------------------------

model Issue {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  key             String
  title           String
  description     String?
  type            String       @default("BUG") // BUG, FEATURE, TASK, IMPROVEMENT
  status          String       @default("OPEN") // OPEN, IN_PROGRESS, IN_REVIEW, RESOLVED, CLOSED
  priority        String       @default("MEDIUM") // URGENT, HIGH, MEDIUM, LOW
  severity        String       @default("MODERATE") // CRITICAL, MAJOR, MODERATE, MINOR
  module          String       @default("General")
  reproducibility String       @default("Always")
  environment     String       @default("Production")
  dueDate         DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  milestoneId     String?
  milestone       Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  assigneeId      String?
  assignee        User?        @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId      String?
  reporter        User?        @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)

  comments        Comment[]

  @@unique([organizationId, key])
  @@index([organizationId, projectId])
  @@index([organizationId, status])
  @@index([assigneeId])
  @@index([reporterId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// -----------------------------------------------------------------------------
// 5. Security & Audit Trail
// -----------------------------------------------------------------------------

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  action         String       // e.g. "USER_INVITED", "ROLE_UPDATED", "PROJECT_CREATED"
  resourceType   String       // e.g. "ORGANIZATION", "TEAM", "PROJECT", "ISSUE"
  resourceId     String?
  details        String?      // JSON metadata string
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}
